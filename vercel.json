{
  "framework": null,
  "installCommand": "npm install",
  "buildCommand": "EXPO_PUBLIC_API_BASE_URL=/ npx expo export --platform web --output-dir dist",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/:path*", "destination": "http://15.135.9.219:8080/api/:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
